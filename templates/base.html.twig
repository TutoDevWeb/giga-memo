<!DOCTYPE html>
<html>

	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		<link
		href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">


		{# Block style CSS #}
		{% block stylesheets %}{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
		<script defer src="{{asset('assets/js/scripts.js')}}"></script>

	</head>

	<body class="d-flex flex-column min-vh-100" data-controller="answer image-preview">

		{% include "_partials/_ariane.html.twig" %}

		<main class="flex-grow-1"> {% block body %}{% endblock %}
			</main>

			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

			<footer class="footer py-3">
				<div class="container">
					<div class="d-flex justify-content-center align-items-center gap-3 flex-wrap">
						<small>
							<i class="bi bi-journal-code me-2"></i>
							Memo - Application Symfony •
							{{ "now"|date("Y") }}
						</small>

						<small>
							<a href="{{ asset('docs/documentation.pdf') }}" class="text-decoration-none" target='_blank'>
								<i class="bi bi-book me-1"></i>
								Documentation
							</a>
						</small>
					</div>
				</div>
			</footer>
		</body>
	</html>
