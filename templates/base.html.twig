<!DOCTYPE html>
<html>

	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		{# Block style CSS #}
		{% block stylesheets %}{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>

	<body class="d-flex flex-column min-vh-100" data-controller="answer image-preview">

		{% include "_partials/_ariane.html.twig" %}
		{% include "_partials/_flashes.html.twig" %}

		<main class="flex-grow-1"> {% block body %}{% endblock %}
			</main>

			<footer class="footer py-3">
				<div class="container">
					<div class="d-flex justify-content-center align-items-center gap-3 flex-wrap">
						<small>
							<i class="bi bi-journal-code me-2"></i>
							Memo - Application Symfony •
							{{ "now"|date("Y") }}
						</small>

						<small>
							<a href="{{ asset('docs/documentation.pdf') }}" class="text-decoration-none" target='_blank'>
								<i class="bi bi-book me-1"></i>
								Documentation
							</a>
						</small>
					</div>
				</div>
			</footer>
		</body>
	</html>
