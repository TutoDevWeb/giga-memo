{% extends 'base.html.twig' %}

{% block title %}Gestion des calendriers{% endblock %}

{% block body %}

    <div class="container">
        <h1>Gestion des calendriers</h1>

        <p>Aujourd'hui nous sommes le {{ dateStart|format_datetime(pattern = 'EEEE d MMMM yyyy') }}</p>

        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">Calendrier des révisions</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Numéro</th>
                                <th class="ps-3">
                                    <i class="bi bi-calendar-event text-light me-2"></i>
                                    Jour & Date
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for dateDay in dateDays %}
                                {% set i = loop.index0 %}
                                {% set numDay = numDays[i] %}
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary">J + {{ numDay }}</span>
                                    </td>
                                    <td class="ps-3 fw-semibold">                                     
                                        {{ dateDay|format_datetime(pattern = 'EEEE d MMMM yyyy')|capitalize }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

{% endblock %}
