{# /templates/main/index.html.twig #}
{% extends 'layouts/dashboard_index.html.twig' %}

{% block title %}Tableau de bord principal
{% endblock %}

{% set dashboard_title = 'Tableau de bord principal' %}

{% block dashboard_content %}


	<div class='text-center p-4 mt-4'>
		<a class='btn btn-primary' href={{path('app_categories_list')}}>Gérer les catégories</a>
	</div>

	{{ form_start(form) }}
	<div>
		<div class="p-4 mt-4">
			<div class="row text-center">

				{{ form_errors(form) }}
				<div data-controller="dynamic-select">

					{{ form_label(form.category, null, { 'label': 'Choisir la catégorie','label_attr': {'class':'mt-4'}}) }}
					{{ form_errors(form.category) }}
					{{ form_widget(form.category) }}


					{{ form_label(form.faq, null, { 'label': 'Choisir la FAQ','label_attr': {'class':'mt-4'}}) }}
					{{ form_errors(form.faq) }}
					{{ form_widget(form.faq) }}

				</div>
			</div>

			<div class="row text-center">

				<div class="col-12 col-md-6 p-4 d-flex justify-content-center">
					{{ form_widget(form.edit, { 'label': 'Éditer la FAQ', 'attr': { 'class': 'btn btn-primary btn-responsive' } }) }}
				</div>

				<div class="col-12 col-md-6 p-4 d-flex justify-content-center">
					<a class="btn btn-primary btn-responsive" href="{{ path('app_faqs_new') }}">
						Créer une nouvelle FAQ
					</a>
				</div>

			</div>

		</div>

		<div class="row my-4 text-center">

			<div class="col-12">
				{{ form_widget(form.run,{ 'label': 'Exécuter la FAQ' ,'attr': {'class': 'btn-primary mt-4'}}) }}
			</div>

		</div>


	</div>
	{{ form_end(form) }}

{% endblock %}
