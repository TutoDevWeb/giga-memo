{% extends 'base.html.twig' %}

{% block title %}Accueil du mode Run
{% endblock %}

{% block body %}

	<h1 class=' text-center h3'>Accueil du Mode Run</h1>

	<h2 class=' text-center darkred h4'>{{ faq.name }}</h2>

	{% if faq.duration is not null %}
		<h3 class='text-center darkred h6'>{{ faq.duration.format('%i minutes') }}</h3>
	{% endif %}

	{# Liste des actions lorsqu'une Faq est sélectionner #}
	{% if faq != null %}
		<div class="container">
			<div class="row text-center">
				<div class="col-12 col-md-3 p-4">
					<a class='btn btn-primary' title='Run de toute la Faq' href="{{path('app_faqs_run',{id : faq.id})}}">Run
						{# #}
						(<span id='nbSelectRun'>{{nbSelectRun}}</span>/<span id='nbTodoRun'>{{nbTodoRun}}</span>)</a>
				</div>
				<div class="col-12 col-md-3 p-4">
					<a class='btn btn-primary' title='Run de ce qui est à revoir' href="{{path('app_faqs_review',{id : faq.id})}}">Review
						{# #}
						(<span id='nbSelectReview'>{{nbSelectReview}}</span>/<span id='nbTodoReview'>{{nbTodoReview}}</span>)
					</a>
				</div>
				<div class="col-12 col-md-3 p-4">
					<button id="{{'restart_' ~ faq.id}}" title='Restart de toute la Faq' class='btn btn-primary btn-restart' data-token={{ csrf_token('restart' ~ faq.id)}}>Restart</button>
				</div>
				<div class="col-12 col-md-3 p-4">
					<button id="{{'reset_review_' ~ faq.id}}" title='Reset des review de la Faq' class='btn btn-primary btn-reset-review' data-token={{ csrf_token('reset-review' ~ faq.id)}}>Reset Review
						{# #}
					</button>
				</div>
			</div>
		</div>
	{% endif %}

{% endblock %}
