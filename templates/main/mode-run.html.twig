{% extends 'layouts/dashboard_modes.html.twig' %}

{% block title %}Accueil du mode Run
{% endblock %}

{% set dashboard_title = 'Accueil des modes Run de la faq' %}

{% block dashboard_subtitle %}

	<h2 class='h5'>{{ faq.name }}</h2>

	{% if faq.duration is not null %}
		<h3 class='h6'>{{ faq.duration.format('%i minutes') }}</h3>
	{% endif %}

{% endblock %}

{% block dashboard_content_left %}
	<p>Run en mode normal</p>
	<a class='btn btn-primary' href="{{path('app_faqs_run',{'id_faq' : faq.id})}}">Run
		{# #}
		(<span title='Nombre total de questions' id='nbSelectRun'>{{nbSelectRun}}</span>/<span title='Nombre restant de questions' id='nbTodoRun'>{{nbTodoRun}}</span>)</a>
	<button id="{{'restart_' ~ faq.id}}" class='btn btn-primary btn-restart' data-token={{ csrf_token('restart' ~ faq.id)}}>Reprendre le run au début</button>
{% endblock %}

{% block dashboard_content_right %}
	<p>Run en mode révision</p>
	<a class='btn btn-primary' href="{{path('app_faqs_review',{'id_faq' : faq.id})}}">Run
		{# #}
		(<span title='Nombre total de questions à revoir' id='nbSelectReview'>{{nbSelectReview}}</span>/<span title='Nombre restant de questions à revoir' id='nbTodoReview'>{{nbTodoReview}}</span>)
	</a>
	<button id="{{'reset_review_' ~ faq.id}}" class='btn btn-primary btn-reset-review' data-token={{ csrf_token('reset-review' ~ faq.id)}}>Vider la liste de révision
		{# #}
	</button>
{% endblock %}
