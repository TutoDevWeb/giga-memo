{% extends 'layouts/dashboard_modes.html.twig' %}

{% block title %}Accueil des modes d'exécution de la FAQ
{% endblock %}

{% set dashboard_title = 'Accueil des modes d\'exécution de la FAQ' %}

{% block dashboard_subtitle %}

	<h2 class='h5'>{{ faq.name }}</h2>

	{% if faq.duration is not null %}
		<h3 class='h6'>{{ faq.duration.format('%i minutes') }}</h3>
	{% endif %}

{% endblock %}

{% block dashboard_content_left %}
	<p>Exécuter en mode normal</p>
	<a class='btn btn-primary' href="{{path('app_faqs_run',{'id_faq' : faq.id})}}">Normal
		{# #}
		(<span title='Nombre total de questions' data-counter-action-target='totalToRun'>{{counters.totalToRun}}</span>/<span title='Nombre restant de questions' data-counter-action-target='remainingToRun'>{{counters.remainingToRun}}</span>)</a>
	<button
		class='btn btn-primary'
		data-action="click->counter-action#send"
		data-url="{{ path('app_faqs_restart', {'id_faq': faq.id}) }}"
		data-token="{{ csrf_token('restart' ~ faq.id) }}"
	>Reprendre l'exécution au début</button>
{% endblock %}

{% block dashboard_content_right %}
	<p>Exécuter en mode révision</p>
	<a class='btn btn-primary' href="{{path('app_faqs_review',{'id_faq' : faq.id})}}">Révision
		{# #}
		(<span title='Nombre total de questions à revoir' data-counter-action-target='totalToReview'>{{counters.totalToReview}}</span>/<span title='Nombre restant de questions à revoir' data-counter-action-target='remainingToReview'>{{counters.remainingToReview}}</span>)
	</a>
	<button class='btn btn-primary' data-action="click->counter-action#send" data-url="{{ path('app_faqs_reset_review', {'id_faq': faq.id}) }}" data-token="{{ csrf_token('reset-review' ~ faq.id) }}">Vider la liste de révision
		{# #}
	</button>
{% endblock %}
