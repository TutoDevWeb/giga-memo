{# /templates/main/index_start_create_category.html.twig  #}
{% extends 'layouts/dashboard_index.html.twig' %}

{% block title %}Création de la première catégorie
{% endblock %}


{% set dashboard_title = 'Démarer : Créer la première catégorie' %}

{% block dashboard_content %}

	{{ form_start(form) }}
	<div class="row">
		<div class="col">

			{{ form_label(form.name, null, { 'label': 'Saisir le nom de votre première catégorie','label_attr': {'class':'mt-4'}}) }}
			{{ form_widget(form.name) }}
			{{ form_errors(form.name) }}

			<button class="btn btn-primary mt-4">Créer la catégorie</button>
		</div>
	</div>
	{{ form_end(form) }}
{% endblock %}
