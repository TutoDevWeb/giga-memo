{# /templates/main/mode-edit.html.twig #}
{% extends 'layouts/dashboard_modes.html.twig' %}

{% block title %}Accueil du mode Edit
{% endblock %}

{% set dashboard_title = 'Accueil du mode Edit' %}

{% block dashboard_subtitle %}

	<h2 class='text-center darkred h4'>{{ faq.name }}</h2>

{% endblock %}

{% block dashboard_content_left %}

	<a class="btn btn-primary btn-action" href="{{ path('app_couples_list_by_faq', {'id_faq': faq.id}) }}" title="Voir la liste des QRs (Question/Réponse) de la FAQ">
		Liste des QRs de la FAQ
	</a>

	<a class="btn btn-primary btn-action" href="{{ path('app_rules_list_by_faq', {'id_faq': faq.id}) }}" title="Voir la liste des Règles de la FAQ">
		Liste des règles de la FAQ
	</a>

{% endblock %}

{% block dashboard_content_right %}
	<a class="btn btn-primary btn-action" href="{{ path('app_faqs_update', {'id_faq': faq.id}) }}" title="Modifier la FAQ">
		Modifier la FAQ
	</a>

	{{ include('faqs/_delete_form.html.twig') }}

{% endblock %}
