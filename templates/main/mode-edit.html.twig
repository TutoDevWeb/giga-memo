{% extends 'base.html.twig' %}

{% block title %}Accueil du mode Edit
{% endblock %}

{% block body %}

	<h1 class=' text-center h3'>Accueil du mode Edit</h1>

	<h2 class='text-center darkred h4'>{{ faq.name }}</h2>

	{# Liste des actions lorsqu'une Faq est sélectionner #}
	{% if faq != null %}
		<div class="container">
			<div class="row text-center">
				<div class="col-12 col-md-3 p-4">
					<a class='btn btn-primary' title='Voir la liste des QRs (Question/Réponse) de la Faq' href="{{path('app_couples_list_by_faq',{'id_faq' : faq.id})}}">Liste des QRs de la Faq</a>
				</div>
				<div class="col-12 col-md-3 p-4">
					<a class='btn btn-primary' title='Voir la liste des Règles de la Faq' href="{{path('app_rules_list_by_faq',{'id_faq' : faq.id})}}">Liste des règles de la Faq</a>
				</div>
				<div class="col-12 col-md-3 p-4">
					<a class='btn btn-primary' title='Modifier la Faq' href="{{path('app_faqs_update',{'id_faq' : faq.id})}}">Modifier la Faq</a>
				</div>
				<div class="col-12 col-md-3 p-4">
					<a onclick="return confirm('Etes vous sûr de vouloir supprimer ?');" class='btn btn-primary' title='Supprimer la Faq' href="{{path('app_faqs_delete',{'id_faq' : faq.id})}}">Supprimer la Faq</a>
				</div>
			</div>
		</div>
	{% endif %}

{% endblock %}
