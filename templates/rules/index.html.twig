{% extends 'base.html.twig' %}

{% block title %}Rules index
{% endblock %}

{% block body %}
	<div class="container">
		<div class="row">
			<div class="col">

				<h1>Rules index</h1>

				<table class="table">
					<thead>
						<tr>
							<th>Id</th>
							<th>Name</th>
							<th>Content</th>
							<th>actions</th>
						</tr>
					</thead>
					<tbody>
						{% for rule in faq.rules %}
							<tr>
								<td>{{ rule.id }}</td>
								<td>{{ rule.name }}</td>
								<td>{{ rule.content }}</td>
								<td>
									<a class='btn btn-primary' href="{{ path('app_rules_show', {'id_faq': faq.id,'id_rule': rule.id}) }}">show</a>
									<a class='btn btn-primary' href="{{ path('app_rules_edit', {'id_faq': faq.id,'id_rule': rule.id}) }}">edit</a>
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="4">Pas d'enregistrement</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>

				<a class='btn btn-primary' href="{{ path('app_rules_new',{'id_faq': faq.id}) }}">Création nouvelle règle</a>

			</div>
		</div>
	</div>
{% endblock %}
