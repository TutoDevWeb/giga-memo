{% extends 'layouts/crud_list.html.twig' %}

{% set page_title = 'Gestion des règles' %}
{% set page_icon = 'bi-card-checklist' %}

{% block list %}
	<div class="table-responsive">
		<table class="table table-dark table-hover text-center">
			<thead>
				<tr>
					<th>Id</th>
					<th>Name</th>
					<th>Content</th>
					<th></th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{% for rule in faq.rules %}
					<tr>
						<td class='idTable'>(*{{ rule.id }})</td>
						<td>{{ rule.name }}</td>
						<td>{{ rule.content }}</td>
						<td>
							<a class='btn btn-primary' href="{{ path('app_rules_edit', {'id_faq': faq.id,'id_rule': rule.id}) }}">Modifier la règle</a>
						</td>
						<td>
							{{ include('rules/_delete_form.html.twig') }}</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="4">Pas d'enregistrement</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

{% endblock %}

{% block actions %}

	<a class="btn btn-primary" href="{{ path('app_rules_new',{'id_faq': faq.id}) }}">
		<i class="bi bi-plus-circle me-2"></i>

		Créer une nouvelle règle
	</a>

{% endblock %}
