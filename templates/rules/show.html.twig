{% extends 'base.html.twig' %}

{% block title %}Rules
{% endblock %}

{% block body %}
	<div class="container">
		<div class="row">
			<div class="col">

				<h1>Rules</h1>

				<table class="table">
					<tbody>
						<tr>
							<th>Id</th>
							<td>{{ rule.id }}</td>
						</tr>
						<tr>
							<th>Name</th>
							<td>{{ rule.name }}</td>
						</tr>
						<tr>
							<th>Content</th>
							<td>{{ rule.content }}</td>
						</tr>
					</tbody>
				</table>

				<a class='btn btn-primary mt-4' href="{{ path('app_rules_list_by_faq',{'id_faq':faq.id}) }}">back to list</a>

				<a class='btn btn-primary mt-4' href="{{ path('app_rules_edit', {'id_faq':faq.id,'id_rule': rule.id}) }}">edit</a>

				{{ include('rules/_delete_form.html.twig') }}


			</div>
		</div>
	</div>
{% endblock %}
