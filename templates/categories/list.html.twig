{% extends 'layouts/crud_list.html.twig' %}

{% set page_title = 'Gestion des catégories' %}
{% set page_icon = 'bi-folder-plus' %}

{% block list %}

	{% if (categories|length) != 0 %}

		<table class="table table-dark table-hover text-center">
			<thead>
				<tr>
					<th>Id</th>
					<th>Name</th>
					<th></th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{% for category in categories %}
					<tr>
						<td class='id-record'>(*
							{{ category.id }})</td>
						<td>{{ category.name }}</td>
						<td>
							<a class='btn btn-primary' href="{{ path('app_categories_edit', {'id': category.id}) }}">Modifier</a>
						</td>
						<td>
							{{ include('categories/_delete_form.html.twig') }}
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="3">no records found</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>

	{% else %}

		<p>Il n'y a pas de catégorie</p>

	{% endif %}

{% endblock %}

{% block actions %}

	<a class="btn btn-primary mt-4" href="{{ path('app_categories_new') }}">

		<i class="bi bi-plus-circle me-2"></i>

		Créer une catégorie

	</a>

{% endblock %}
