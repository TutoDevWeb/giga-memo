{# templates/layouts/learning.html.twig #}

{# run / review #}

{% extends 'base.html.twig' %}

	{% block title %}
{{ learning_title }}
{% endblock %}

	{% block body %}

		<div class="container py-4"> <div class="row justify-content-center">

			<div class="col-12 col-md-10 col-lg-8">

				<div class="card shadow-sm">

					<div class="card-header">

						<h1 class="h3 text-center mb-0">
							<i class="bi {{ learning_icon }} me-2"></i>
							{{ learning_title }}
						</h1>

						{% block learning_subtitle %}{% endblock %}

					</div>

					<div class="card-body">

						{% block learning_content %}{% endblock %}

					</div>

					{% block learning_footer %}{% endblock %}

				</div>

			</div>

		</div>

	</div>

{% endblock %}
