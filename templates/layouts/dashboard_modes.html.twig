{# templates/layouts/modes.html.twig #}
{# Pour les pages mode-edit / mode-run #}

{% extends 'base.html.twig' %}

	{% block title %}
{{ dashboard_title }}
{% endblock %}

	{% block body %}

		<div class="container py-4"> <div class="row justify-content-center">

			<div class="col-12 col-md-11 col-lg-10">

				<div class="card shadow-sm">

					<div class="card-header border-secondary-subtle">

						<h1 class="h3 text-center mb-0">
							{{ dashboard_title }}
						</h1>

						{% block dashboard_subtitle %}{% endblock %}

					</div>

					<div
						class="card-body">

						{# Liste des actions lorsqu'une Faq est sélectionner #}
						{% if faq != null %}

							<div class="row g-4 text-center text-white">
								<div class="col-12 col-md-6">
									<div class='p-5 div_run h-100 d-flex flex-column gap-2'> {% block dashboard_content_left %}{% endblock %}
										</div>
									</div>
									<div class="col-12 col-md-6">
										<div class="p-5 div_run h-100 d-flex flex-column gap-2"> {% block dashboard_content_right %}{% endblock %}

											</div>
										</div>
									</div>

								</div>
							{% endif %}

						</div>

					</div>

				</div>

			</div>

		{% endblock %}
