{# templates/layouts/dashboard.html.twig #}

{# index / mode-edit / mode-run #}

{% extends 'base.html.twig' %}

	{% block title %}
{{ dashboard_title }}
{% endblock %}

	{% block body %}

		<div class="container py-4"> <div class="row justify-content-center">

			<div class="col-12 col-md-10 col-lg-8">

				<div class="card shadow-sm">

					<div class="card-header">

						<h1 class="h3 text-center mb-0">
							<i class="bi {{ dashboard_icon }} me-2"></i>
							{{ dashboard_title }}
						</h1>

						{% block dashboard_subtitle %}{% endblock %}

					</div>

					<div class="card-body">

						{% block dashboard_content %}{% endblock %}

					</div>

					{% block dashboard_footer %}{% endblock %}

				</div>

			</div>

		</div>

	</div>

{% endblock %}
