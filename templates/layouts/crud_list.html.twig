{% extends 'base.html.twig' %}

{% block title %}
	{{ page_title }}
{% endblock %}

{% block body %}

	<div class="container py-4">

		<div class="row justify-content-center">

			<div class="col-12">

				<div class="card shadow-sm">

					<div class="card-header border-secondary-subtle">

						<h1 class="h3 text-center mb-0">
							<i class="bi {{ page_icon }} me-2"></i>
							{{ page_title }}
						</h1>

						{% block subtitle %}{% endblock %}

					</div>

					<div class="card-body">

						{% block list %}{% endblock %}

					</div>

					<div class="card-footer text-end border-secondary-subtle">

						{% block actions %}{% endblock %}

					</div>

				</div>

			</div>

		</div>

	</div>

{% endblock %}
