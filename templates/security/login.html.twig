{% extends 'base.html.twig' %}

{% block title %}super-memo.fr Connexion
{% endblock %}

{% block body %}

	<div class="container">
		<div class="row">
			<div class="col mt-4">

				<form method="post">
					{% if error %}
						<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
					{% endif %}

					<h1 class="h3 mb-3 font-weight-normal">Merci de vous connecter !</h1>
					<label for="username">Votre email</label>
					<input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
					<label class='mt-4' for="password">Votre mot de passe</label>
					<input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
					<input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

					<button class="btn btn-lg btn-primary mt-4 mb-5" type="submit">
						Connexion
					</button>
				</form>

				<p class="mt-5">
					Merci de vous inscrire si vous ne l'êtes pas !
					<a href={{ path('app_register')}}>Inscription</a>
				</p>

				<p class="mt-5">
					Si vous avez besoin de réinitialiser votre mot de passe merci de cliquer sur ce lien !
					<a href={{ path('app_forgot_password_request')}}>Je demande la réinitialisation de mon mot de passe</a>
				</p>


			</div>
		</div>
	</div>
{% endblock %}
