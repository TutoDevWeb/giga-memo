{# ########################## #}
{# Déclaration de la macro mainIndex
Je suis obligé de passer la variable faq car elle n'est pas vue dans la macro.
Le problème c'est qu'il arrive que cette variable ne soit pas définie alors que le script est inclu.
Dans ces conditions il faut faire un appel du type mainIndex(false,faq|default(null)) #}
	{% macro mainIndex(link,faq) %}

	Vous êtes ici ::&nbsp;&nbsp;

		{% if link == true %}

			{% if faq is not null and faq.id is defined %}
				<a class="ariane" href="{{path('app_main_index',{id_faq: faq.id})}}"> Tableau de bord principal</a>
		{% else %}
			<a class="ariane" href="{{path('app_main_index')}}">Tableau de bord principal</a>
		{% endif %}

	{% else %}
		Tableau de bord principal
	{% endif %}

{% endmacro %}

{% macro mainStartCreateCategorie() %}

	Vous êtes ici ::&nbsp;&nbsp;Création de la première catégorie

{% endmacro %}

{% macro mainStartCreateFaq() %}

	Vous êtes ici ::&nbsp;&nbsp;Création de la première FAQ

{% endmacro %}

