{% if couple.images|length %}
	<div class="container mt-4">
		{% for image in couple.images %}
			<div data-answer-target="image" class="image-container hidden mt-4">
				<img src="{{ asset(image.name,'images_directory')}}" alt="...">
			</div>
		{% endfor %}
	</div>
{% endif %}
