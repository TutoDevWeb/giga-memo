{% import "_partials/_ariane_macros.html.twig" as Ariane %}


<nav class="container">
	<div class="row align-items-center my-4">

		<div class="col text-start p-2">

			{% if app.current_route == 'app_main_index' %}
				{{ Ariane.mainIndex(false,faq|default(null)) }}
			{% elseif app.current_route == 'app_categories_list' %}
				{{ Ariane.mainIndex(true,faq|default(null)) }}
				{{ Ariane.categoriesList(false) }}
			{% elseif app.current_route == 'app_categories_edit' %}
				{{ Ariane.mainIndex(true,faq|default(null)) }}
				{{ Ariane.categoriesList(true) }}
				{{ Ariane.categoriesEdit() }}
			{% elseif app.current_route == 'app_categories_new' %}
				{{ Ariane.mainIndex(true,faq|default(null)) }}
				{{ Ariane.categoriesList(true) }}
				{{ Ariane.categoriesNew() }}
			{% elseif app.current_route == 'app_main_edit' %}
				{{ Ariane.mainIndex(true,faq|default(null)) }}
				{{ Ariane.mainEdit(false,faq|default(null)) }}
			{% elseif app.current_route == 'app_faqs_update' %}
				{{ Ariane.mainIndex(true,faq|default(null)) }}
				{{ Ariane.mainEdit(true,faq|default(null)) }}
				{{ Ariane.faqsUpdate() }}
			{% elseif app.current_route == 'app_faqs_new' %}
				{{ Ariane.mainIndex(true,faq|default(null)) }}
				{{ Ariane.faqsNew() }}
			{% elseif app.current_route == 'app_couples_list_by_faq' %}
				{{ Ariane.mainIndex(true,faq|default(null)) }}
				{{ Ariane.mainEdit(true,faq|default(null)) }}
				{{ Ariane.couplesListByFaq() }}
			{% elseif app.current_route == 'app_couples_update' %}
				{{ Ariane.mainIndex(true,faq|default(null)) }}
				{{ Ariane.mainEdit(true,faq|default(null)) }}
				{{ Ariane.couplesListByFaq(true,faq|default(null)) }}
				{{ Ariane.couplesUpdate() }}
			{% elseif app.current_route == 'app_couples_new' %}
				{{ Ariane.mainIndex(true,faq|default(null)) }}
				{{ Ariane.mainEdit(true,faq|default(null)) }}
				{{ Ariane.couplesListByFaq(true,faq|default(null)) }}
				{{ Ariane.couplesNew() }}
			{% elseif app.current_route == 'app_rules_list_by_faq' %}
				{{ Ariane.mainIndex(true,faq|default(null)) }}
				{{ Ariane.mainEdit(true,faq|default(null)) }}
				{{ Ariane.rulesListByFaq() }}
			{% elseif app.current_route == 'app_rules_new' %}
				{{ Ariane.mainIndex(true,faq|default(null)) }}
				{{ Ariane.mainEdit(true,faq|default(null)) }}
				{{ Ariane.rulesListByFaq(true,faq|default(null)) }}
				{{ Ariane.rulesNew() }}
			{% elseif app.current_route == 'app_rules_edit' %}
				{{ Ariane.mainIndex(true,faq|default(null)) }}
				{{ Ariane.mainEdit(true,faq|default(null)) }}
				{{ Ariane.rulesListByFaq(true,faq|default(null)) }}
				{{ Ariane.rulesEdit() }}
			{% elseif app.current_route == 'app_main_run' %}
				{{ Ariane.mainIndex(true,faq|default(null)) }}
				{{ Ariane.mainRun(false,faq|default(null)) }}
			{% elseif app.current_route == 'app_faqs_run' %}
				{{ Ariane.mainIndex(true,faq|default(null)) }}
				{{ Ariane.mainRun(true,faq|default(null)) }}
				{{ Ariane.faqsRun() }}
			{% elseif app.current_route == 'app_faqs_review' %}
				{{ Ariane.mainIndex(true,faq|default(null)) }}
				{{ Ariane.mainRun(true,faq|default(null)) }}
				{{ Ariane.faqsReview() }}
			{% elseif app.current_route == 'app_main_start_create_category' %}
				{{ Ariane.mainStartCreateCategorie() }}
			{% elseif app.current_route == 'app_main_start_create_faq' %}
				{{ Ariane.mainStartCreateFaq() }}
			{% elseif app.current_route == 'app_login' %}
			{% elseif app.current_route == 'app_register' %}


			{% else %}
				{{ app.current_route }}
			{% endif %}

		</div>

		{% if app.user and not app.user.isVerified %}
			<div class="col-auto p-2">
				<form method="post" action="{{ path('app_verify_email_resend') }}">
					<input type="hidden" name="_token" value="{{ csrf_token('resend-verification-email') }}">
					<button type="submit" class="btn btn-link">Renvoyer l'email de vérification</button>
				</form>
			</div>
		{% endif %}

		{% if app.user %}
			<div class="col-auto p-2">
				<a href="{{ logout_path() }}">
					<img src="{{ asset('media/logout.png') }}" width="32" height="32" alt="Se déconnecter">
				</a>
			</div>
		{% endif %}

	</div>
</nav>

{# {{ dump(_context|keys) }}
	
	{% if faq is defined  %}
	
		{{ dump(faq) }}
	
		{{ dump(faq.id) }}
	
	{% endif %} #}
