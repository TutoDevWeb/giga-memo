{% extends 'base.html.twig' %}

{% block title %}
	Memo: Liste des questions / Réponses
{% endblock %}

{% block body %}

	<div class="image-preview-overlay" data-image-preview-target="container">
		<img src="" alt="Aperçu" data-image-preview-target="image">
	</div>

	<div class="container">
		<h1 class='text-center h3'>Liste des Questions / Réponses</h1>

		{% if (faq.couples|length) != 0 %}
			<table class="table text-center">
				<thead>
					<tr>
						<th>Id</th>
						<th>Position</th>
						<th>Question</th>
						<th>Réponse</th>
						<th></th>
						<th></th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{% for couple in faq.couples %}
						<tr>
							<td class='idTable'>(*
								{{couple.id}})</td>
							<td>{{ couple.num }}</td>
							<td>{{ couple.question }}</td>
							<td>

								{% if couple.reponse != '' %}
									<p>{{ couple.reponse }}</p>
								{% endif %}


								{% for image in couple.images %}
									<a href="#" class="preview-link" data-image-preview-url="{{ asset(image.name,'images_directory') }}" data-action="mouseenter->image-preview#show mouseleave->image-preview#hide">
										{{image.id }}
									</a>
								{% endfor %}

							</td>
							{# <td>{{ couple.regle }}</td> #}
							<td>
								{% for rule in couple.rules %}
									{{ rule.name }}
								{% endfor %}
							</td>
							<td>
								<a href="{{ path('app_couples_update', { 'from' : 'list','id_faq' : faq.id, 'id_couple': couple.id }) }}" class="btn btn-primary">Modifier</a>
							</td>
							<td>
								<a href="{{ path('app_couples_delete', {'id_faq' : faq.id,'id_couple': couple.id }) }}" class="btn btn-primary" onclick="return confirm('Etes vous sûr de vouloir supprimer ?');">Supprimer</a>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		{% else %}
			<p>Il n'y a pas de couple question/reponse dans cette Faq</p>
		{% endif %}
		<div class="my-4">
			<a href="{{ path('app_couples_new', { 'id_faq': faq.id }) }}" class="btn btn-primary">Créer un nouveau couple QR</a>
		</div>
		<div style="height: 100vh;"></div>
	</div>
{% endblock %}
