{% if formType == 'update' %}

	{% for image in couple.images %}

		<div class="mt-5 ms-4">

			<img src="{{ asset(image.name,'images_directory')}}" alt="mes images" width="250">

			<a href="{{ path('couple_delete_image',{id:image.id})}}" class="btn btn-delete-trigger btn-sm" data-bs-toggle="modal" data-token="{{ csrf_token('delete' ~ image.id)}}" data-bs-target="#ModalImage">
				Supprimer l'image
			</a>

		</div>

	{% endfor %}

{% endif %}

<button class="btn btn-primary mt-4">
	<i class="bi bi-{{ button_icon|default('check-circle') }} me-2"></i>
	{{ button_label|default('Default') }}
</button>

{{ form_end(form) }}

