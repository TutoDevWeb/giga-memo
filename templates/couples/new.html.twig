{% extends 'base.html.twig' %}

{% block title %}Memo: Liste des questions / réponses
{% endblock %}

{% block body %}

	<div class='container'>

		<h1 class='text-center h3'>Création d'un couple Question / Réponse</h1>

		<div class="form-control">
			{{ form_start(form) }}

			{# Champ num #}
			{{ form_label(form.question, null, { 'label': 'Numéro','label_attr': {'class': 'mt-4'}}) }}
			{{ form_widget(form.num) }}

			{{ form_label(form.faq, null, { 'label': 'Sélectionner la Faq','label_attr': {'class': 'mt-4'}}) }}
			{{ form_widget(form.faq, {'attr': {'disabled': 'disabled'}}) }}

			{# Champ rules #}
			{{ form_label(form.rules, null, { 'label': 'Rules','label_attr': {'class': 'mt-4'}}) }}
			{{ form_widget(form.rules, { 'attr': {'class': 'mt-4'}}) }}

			{# Champ régle #}
			{% if faq.layerType.name ==  'LAYER_ONE' %}
				{{ form_label(form.regle, null, { 'label': 'Régle','label_attr': {'class': 'mt-4'}}) }}
				{{ form_widget(form.regle) }}
			{% endif %}

			{# Champ question #}
			{{ form_label(form.question, null, { 'label': 'Question','label_attr': {'class': 'mt-4'}}) }}
			{{ form_widget(form.question, { 'attr': {'class': 'form-control-auto mt-4'}}) }}

			{# Champ réponse #}
			{{ form_label(form.reponse, null, { 'label': 'Réponse','label_attr': {'class': 'mt-4'}}) }}
			{{ form_widget(form.reponse, { 'attr': {'class': 'form-control-auto mt-4'}}) }}

			{{ form_label(form.images, null, { 'label': 'Ajouter les images','label_attr': {'class': 'mt-4'}}) }}
			{{ form_widget(form.images) }}

			{# Bouton Créer #}
			{{ form_widget(form.submit, { 'label': 'Créer un couple question / réponse' , 'attr': {'class': 'btn btn-warning
		mt-4'}}
			) }}

			{{ form_errors(form) }}

			{{ form_end(form) }}
		</div>

	</div>
{% endblock %}
