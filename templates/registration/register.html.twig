{% extends 'base.html.twig' %}

{% block title %}Formulaire d'inscription
{% endblock %}

{% block body %}

	<div class="container">
		<div class="row">
			<div class="col mt-4">

				<h1 class="h3 mb-3 font-weight-normal">Merci de vous inscrire !</h1>

				{{ form_errors(registrationForm) }}

				{{ form_start(registrationForm) }}
				{{ form_row(registrationForm.email, { label: 'Votre email' }) }}
				{{ form_row(registrationForm.plainPassword, { label: 'Votre mot de passe' }) }}

				<button type="submit" class="btn btn-primary mb-5">S'inscrire</button>
				{{ form_end(registrationForm) }}

				<p class="mt-5">
					Merci de vous connecter si vous êtes déjà inscrit !
					<a href={{ path('app_login')}}>Connexion</a>
				</p>

			</div>
		</div>
	</div>
{% endblock %}
