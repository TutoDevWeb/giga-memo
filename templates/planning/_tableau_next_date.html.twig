
{% if faqsNextRevisionDays|length > 0 %}
    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-4 text-center">Bilan des prochains jours de révision<br>pour toutes les Faqs</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0 text-center">
                    <thead>
                        <tr>
                            <th class="p-4">Faq</th>
                            <th class="p-4">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for faqsNextRevisionDay in faqsNextRevisionDays %}
                            <tr>
                                <td>
                                    {{ faqsNextRevisionDay.faq }}
                                </td>
                                <td>
                                    {{ faqsNextRevisionDay.nextDate|format_datetime(pattern = 'EEEE d MMMM yyyy')|capitalize }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% else %}
    <h5 class="p-4 text-center">Il n'y a pas encore de jour de révision de programmé</h5>
{% endif %}
