<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-4 text-center">Calendrier des révisions</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0 text-center">
                <thead>
                    <tr>
                        <th class="p-4">Révision</th>
                        <th class="p-4">Cycle</th>
                        <th class="p-4">Décalage</th>
                        <th class="p-4">
                            <i class="bi bi-calendar-event text-light me-2"></i>
                            Jour & Date
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for revisionDay in revisionDays %}
                        {% set is_past = date(revisionDay.dateDay) <= date() %}
                        <tr class="{{ is_past ? 'back-over' }}">
                            <td>
                                {{ revisionDay.numDay }}
                            </td>
                            <td class="{{ revisionDay.cycleNum is even ? 'back-even' : 'back-odd' }}">
                                cycle {{ revisionDay.cycleNum }}
                            </td>
                            <td class="{{ revisionDay.cycleNum is even ? 'back-even' : 'back-odd' }}">
                                <span class="badge bg-secondary">J + {{ revisionDay.offsetDay }}</span>
                            </td>
                            <td>                                     
                                {{ revisionDay.dateDay|format_datetime(pattern = 'EEEE d MMMM yyyy')|capitalize }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
