<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0">Calendrier des révisions</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Numéro</th>
                        <th>Décalage</th>
                        <th class="ps-3">
                            <i class="bi bi-calendar-event text-light me-2"></i>
                            Jour & Date
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for revisionDay in revisionDays %}
                        <tr>
                            <td>
                                {{ revisionDay.numDay }}
                            </td>
                            <td>
                                <span class="badge bg-secondary">J + {{ revisionDay.offsetDay }}</span>
                            </td>
                            <td class="ps-3 fw-semibold">                                     
                                {{ revisionDay.dateDay|format_datetime(pattern = 'EEEE d MMMM yyyy')|capitalize }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
