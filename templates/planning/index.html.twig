{% extends 'base.html.twig' %}

{% block title %}Gérer le planning{% endblock %}

{% block body %}

    <div class="container">
        <h1>Gérer le Planning</h1>

        <h2>{{ comment }}</h2>

        {{ dump() }}

 
        {{ form_start(form) }}        

        <div class="row">
            <div class="col">
                {{ form_row(form.timeFrame) }}
            </div>
            <div class="col">
                {{ form_row(form.frequency) }}
            </div>
        </div>

        {{ form_row(form.build, {'label': 'Générer le Planning'}) }}

        {{ include('planning/_tableau_planning.html.twig') }}

        {{ form_row(form.save, {'label': 'Enregistrer le Planning'}) }}

        {{ form_row(form.delete, {'label': 'Supprimer le Planning'}) }}

        {{ form_end(form) }}

    </div>
{% endblock %}


