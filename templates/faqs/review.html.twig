{# /templates/faqs/review.html.twig #}
{% extends 'layouts/dashboard_runs.html.twig' %}

{% block title %}Réviser la FAQ
{% endblock %}

{% set run_type_title = 'Exécution des révisions de la FAQ' %}

{% block bouton_reponse %}
	<button id='bouton-reponse' data-action="click->answer#show" class='btn btn-primary'>Voir La réponse</button>
{% endblock %}

{% block bouton_suivant %}
	<a class='btn btn-primary' href="{{ path('app_faqs_next_review',{ id_faq : faq.id})}}">Suivant
		{# #}
		(<span title='Nombre total de questions à revoir' data-counter-action-target='selectReview'>{{counters.selectReview}}</span>/<span title='Nombre restant de questions à revoir' data-counter-action-target='todoReview'>{{counters.todoReview}}</span>)
	</a>
{% endblock %}

{% block bouton_revoir %}
	<button
		class='btn btn-primary'
		data-action="click->counter-action#send"
		data-url="{{ path('app_couples_cancel_one_review', {'id_couple': couple.id}) }}"
		data-token="{{ csrf_token('cancel-one-review' ~ couple.id) }}"
	>Ne Plus Revoir
		{# #}
	</button>
{% endblock %}

{% block bouton_modifier %}
	<a class='btn btn-primary' href="{{ path('app_couples_update',{ from: 'review','id_faq' : faq.id,id_couple : couple.id})}}">Modifier</a>
{% endblock %}
