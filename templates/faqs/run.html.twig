{# /templates/faqs/run.html.twig  #}
{% extends 'layouts/dashboard_runs.html.twig' %}

{% block title %}Exécution normale de la FAQ
{% endblock %}

{% set run_type_title = 'Exécution normale de la FAQ' %}

{% block bouton_reponse %}
	<button id='bouton-reponse' data-action="click->answer#show" class='btn btn-primary'>Voir La réponse</button>
{% endblock %}

{% block bouton_suivant %}
	<a class='btn btn-primary' href="{{ path('app_faqs_next_run',{ id_faq : faq.id})}}">Suivant
		{#  #}
		(<span title='Nombre total de questions' data-counter-action-target='selectRun'>{{nbSelectRun}}</span>/<span title='Nombre restant de questions' data-counter-action-target='todoRun'>{{nbTodoRun}}</span>)
	</a>
{% endblock %}

{% block bouton_revoir %}
	<button
		class='btn btn-primary'
		data-action="click->counter-action#send"
		data-url="{{ path('app_couples_set_one_review', {'id_couple': couple.id}) }}"
		data-token="{{ csrf_token('set-one-review' ~ couple.id) }}"
	>A Revoir
		{#  #}
		(<span title='Nombre de questions à revoir' data-counter-action-target='selectReview'>{{nbSelectReview}}</span>)
	</button>
{% endblock %}

{% block bouton_modifier %}
	<a class='btn btn-primary' href="{{ path('app_couples_update',{ 'from': 'run','id_faq' : faq.id, 'id_couple' : couple.id})}}">Modifier</a>
{% endblock %}
