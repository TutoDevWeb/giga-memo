{# /templates/faqs/run.html.twig  #}
{% extends 'layouts/dashboard_runs.html.twig' %}

{% block title %}Run du Memo
{% endblock %}

{% set run_type_title = 'Run normal de la faq' %}

{% block bouton_reponse %}
	<button id='bouton-reponse' data-action="click->answer#show" class='btn btn-primary'>Voir La réponse</button>
{% endblock %}

{% block bouton_suivant %}
	<a class='btn btn-primary' href="{{ path('app_faqs_next_run',{ id_faq : faq.id})}}">Suivant
		{#  #}
		(<span title='Nombre total de questions' id='nbSelectRun'>{{nbSelectRun}}</span>/<span title='Nombre restant de questions' id='nbTodoRun'>{{nbTodoRun}}</span>)
	</a>
{% endblock %}

{% block bouton_revoir %}
	<button id='set-one-review' data-couple-id='{{couple.id}}' class='btn btn-primary' data-token={{ csrf_token('set-one-review' ~ couple.id)}}>A Revoir
		{#  #}
		(<span title='Nombre de questions à revoir' id='nbSelectReview'>{{nbSelectReview}}</span>)
	</button>
{% endblock %}

{% block bouton_modifier %}
	<a class='btn btn-primary' href="{{ path('app_couples_update',{ 'from': 'run','id_faq' : faq.id, 'id_couple' : couple.id})}}">Modifier</a>
{% endblock %}
