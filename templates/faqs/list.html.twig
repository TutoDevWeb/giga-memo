{% extends 'layouts/crud_list.html.twig' %}

{% set page_title = 'Gestion des Faqs' %}
{% set page_icon = 'bi-book' %}

{% block list %}

	{% if faqs|length != 0 %}

		{% for faq in faqs %}
			<p>{{faq.name}}</p>
		{% endfor %}

	{% else %}

		<p>Il n'y a pas de Faqs</p>

	{% endif %}

{% endblock %}

{% block actions %}

	<a class="btn btn-primary" href="{{path('app_faqs_new')}}">
		<i class="bi bi-plus-circle me-2"></i>
		Créer une Faq
	</a>

{% endblock %}
