<form class='inline-form' method="post" action="{{ path('app_faqs_delete', {'id_faq': faq.id}) }}" onsubmit="return confirm('Etes vous sûr de vouloir supprimer ?');">
	<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ faq.id) }}">
	<button class="btn btn-primary">Supprimer la faq</button>
</form>
